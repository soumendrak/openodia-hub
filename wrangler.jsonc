{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openodia-hub",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "workers_dev": false,
  "routes": [
    { "pattern": "openodia.com", "custom_domain": true },
    { "pattern": "www.openodia.com", "custom_domain": true },
  ],
  // One-time setup: `wrangler kv namespace create CONTRIBUTORS_KV`,
  // then paste the returned id below. Populated daily by .github/workflows/sync-contributors.yml.
  // CATALOG_KV backs cachedJson (lib/sources/cache) as the globally-replicated
  // layer under the in-isolate memo. Without it a cold isolate re-runs the whole
  // upstream fan-out on the request path — measured at 3.6-5.0s TTFB on /tools
  // and / for ~85% of requests. The code treats the binding as optional and
  // degrades to memo-only, so this stays commented out until the namespace
  // exists; an id that isn't real would fail `wrangler deploy`.
  //
  // To enable:
  //   bunx wrangler kv namespace create CATALOG_KV
  //   then paste the returned id below and uncomment the entry.
  "kv_namespaces": [
    { "binding": "CONTRIBUTORS_KV", "id": "9aee3dc0e2df42f2aa81426a744364ec", "remote": true },
    // { "binding": "CATALOG_KV", "id": "<paste id here>", "remote": true },
  ],
  // One-time setup:
  //   bunx wrangler d1 create openodia-events
  //   bunx wrangler d1 execute openodia-events --remote --file=db/schema.sql
  // Then paste the database_id below. Populated by the scheduled handler in src/server.ts.
  "d1_databases": [
    {
      "binding": "EVENTS_DB",
      "database_name": "openodia-events",
      "database_id": "ec88a8bb-e2f5-42d3-96fe-57191259d49c",
      "remote": true,
    },
  ],
  "triggers": {
    // Every 6h, not daily. The catalog warm-up has to run comfortably inside
    // the shortest KV expiry — repos is TTL 30m + 24h stale = 24.5h — and a
    // daily cron left only 30 minutes of margin, so one delayed or failed run
    // dropped the row and handed the next visitor the full 4s fan-out.
    // The events sync rides along and is simply refreshed 4x a day instead of 1.
    "crons": ["0 */6 * * *"],
  },
}
