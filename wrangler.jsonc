{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openodia-hub",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "workers_dev": false,
  "routes": [
    { "pattern": "openodia.com", "custom_domain": true },
    { "pattern": "www.openodia.com", "custom_domain": true },
  ],
}
